# Optional Wise payment / invoice URL (leave empty until live). Empty hides the pay link; buyers still request an invoice.
VITE_WISE_PAYMENT_URL=
# Optional override for the booking link. Empty uses the Google Calendar appointment page.
# VITE_CAL_BOOKING_URL wins over VITE_BOOKING_URL. Either must be http(s).
VITE_CAL_BOOKING_URL=
# VITE_BOOKING_URL=
# Build base path: / for fourcee.lutho.app, /fourcee/ for ops preview
# FOURCEE_BASE=/
# Where the "Request invoice" form posts leads (server/lead-api). Default /api/lead (same origin via nginx)
VITE_LEAD_ENDPOINT=
# Demo-call guard endpoint (default /api/demo-call, same origin via nginx). The n8n URL is NOT a site setting any more: it lives in the server env.
VITE_DEMO_ENDPOINT=
# Optional Cloudflare Turnstile site key (public). Pair with TURNSTILE_SECRET on the server.
VITE_TURNSTILE_SITE_KEY=

# --- Payments: TEST MODE ONLY (server/lead-api/PAYMENTS.md). Live keys are refused at start-up. ---
# Browser: show "pay now (test mode)" on the confirmation step when the server also has payments on.
VITE_PAYMENTS_ENABLED=
VITE_CHECKOUT_ENDPOINT=
# Server (never VITE_*; these stay in the server environment):
# PAYMENTS_ENABLED=1
# PAY_RETURN_BASE_URL=https://fourcee.lutho.app/
# PAY_ZAR_PER_USD=          # rand per dollar, set by the owner; empty => ZAR checkout refused
# STRIPE_SECRET_KEY=sk_test_...    STRIPE_WEBHOOK_SECRET=whsec_...
# PAYSTACK_SECRET_KEY=sk_test_...

# Internal admin preview (#/admin: sample clients and MRR, no login). Leave EMPTY in production: the screen is not even compiled in.
# Set to 1 only for a private local/staging build.
VITE_ENABLE_ADMIN=
