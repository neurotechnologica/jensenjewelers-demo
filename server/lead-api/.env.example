# Fourcee lead API - environment (copy to /etc/fourcee/lead-api.env on the VPS, chmod 600). NEVER commit real values.
LEAD_HOST=127.0.0.1
LEAD_PORT=8788
LEAD_DATA_DIR=/var/lib/fourcee-lead-api
# Browser origins allowed to POST (comma list, exact match, scheme included)
LEAD_ALLOWED_ORIGINS=https://fourcee.lutho.app
LEAD_ALLOW_NO_ORIGIN=0
# 1 only when behind nginx that sets X-Real-IP (see README)
LEAD_TRUST_PROXY=1
# Limits (per IP): per minute / hour / day, and global leads per day
LEAD_RATE_PER_MIN=5
LEAD_RATE_PER_HOUR=20
LEAD_MAX_PER_DAY_PER_IP=40
LEAD_MAX_PER_DAY=500
# Owner notification by email (SMTP). Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fourcee <leads@example.com>"
LEAD_NOTIFY_TO=owner@example.com
# Optional receipt email to the prospect (needs SMTP). 0/1
LEAD_SEND_CONFIRMATION=0
# Owner notification by webhook (Slack incoming webhook, n8n, Zapier...). Optional HMAC secret adds X-Fourcee-Signature.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
# Storage. Empty = JSON file in LEAD_DATA_DIR. Set to use the platform PostgreSQL (needs `npm install pg`; schema is applied at start-up).
DATABASE_URL=
DATABASE_SSL=0

# ---- Demo-call guard (POST /api/demo-call) ----
# The n8n webhook URL lives ONLY here (server side). Empty = demo calls answer 503.
N8N_DEMO_WEBHOOK_URL=
N8N_DEMO_WEBHOOK_SECRET=
# Kill switch: set to 0 to pause every demo call instantly
DEMO_ENABLED=1
DEMO_DEFAULT_COUNTRY=+27
DEMO_ALLOWED_COUNTRIES=+1,+44,+27,+61,+91,+33,+49,+251,+971,+81
# Caps: per IP per hour/day, per number cooldown (seconds) and per day, global per UTC day (this is your spend cap)
DEMO_PER_IP_PER_HOUR=3
DEMO_PER_IP_PER_DAY=6
DEMO_NUMBER_COOLDOWN_SEC=600
DEMO_PER_NUMBER_PER_DAY=2
DEMO_MAX_PER_DAY=40
# Do-not-call: comma list of E.164 and/or a file with one number per line
DEMO_BLOCKLIST=
DEMO_BLOCKLIST_FILE=
# Optional human check. Set the secret to REQUIRE a valid Cloudflare Turnstile token (site key goes in the site build as VITE_TURNSTILE_SITE_KEY)
TURNSTILE_SECRET=
