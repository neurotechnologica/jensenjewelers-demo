[Unit]
Description=Fourcee lead API
After=network.target postgresql.service

[Service]
User=fourcee
WorkingDirectory=/opt/fourcee-template
EnvironmentFile=/etc/fourcee/lead-api.env
ExecStart=/usr/bin/node server/lead-api/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fourcee-lead-api
PrivateTmp=true

[Install]
WantedBy=multi-user.target
